    "test": "vitest run",
    "eval": "node scripts/eval.ts",
    "render-audio": "node scripts/render-audio.mjs",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
