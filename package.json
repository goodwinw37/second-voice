{
  "name": "second-voice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A voice in your ear when a phone call turns into a scam. Runs entirely on your device.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
